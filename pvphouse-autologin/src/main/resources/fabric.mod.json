{
	"schemaVersion": 1,
	"id": "pvphouse_autologin",
	"version": "${version}",
	"name": "PvPHouse Auto Login",
	"description": "Sends /register or /login on PvPHouse (mc.pvphouse.net) using the credentials saved in PvPHouse Launcher. Only active when started by the launcher.",
	"authors": ["PvPHouse"],
	"contact": {
		"homepage": "https://pvphouse.net",
		"sources": "https://github.com/canbey123x/pvphouselauncher"
	},
	"license": "LGPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": ["net.pvphouse.autologin.PvPHouseAutoLogin"]
	},
	"mixins": [
		{ "config": "pvphouse_autologin.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "1.21.11",
		"java": ">=21"
	}
}
