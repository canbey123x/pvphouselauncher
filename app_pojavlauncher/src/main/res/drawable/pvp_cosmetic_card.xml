<?xml version="1.0" encoding="utf-8"?>
<!-- PvPHouse: cosmetic option card (selected = pink border) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pvp_bg_elevated" />
            <stroke android:width="2dp" android:color="@color/pvp_pink" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pvp_bg_surface" />
            <stroke android:width="1dp" android:color="@color/pvp_bg_elevated" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
