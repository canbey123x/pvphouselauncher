<?xml version="1.0" encoding="utf-8"?>
<!-- PvPHouse: big "Join PvPHouse" button (orange -> red) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pvp_bg_elevated" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/pvp_red_dark" android:endColor="@color/pvp_red_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/pvp_orange" android:endColor="@color/pvp_red" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
