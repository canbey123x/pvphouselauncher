<?xml version="1.0" encoding="utf-8"?>
<!-- PvPHouse: server status + big join button, included at the top of the main menu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pvphouse_server_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pvp_card_background"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/pvphouse_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/pvp_status_dot_unknown" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/noto_sans_bold"
            android:text="@string/pvphouse_server_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_14ssp" />

        <TextView
            android:id="@+id/pvphouse_server_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp"
            tools:text="mc.pvphouse.net" />
    </LinearLayout>

    <TextView
        android:id="@+id/pvphouse_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="@string/pvphouse_status_checking"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_11ssp" />

    <TextView
        android:id="@+id/pvphouse_motd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/pvp_orange_light"
        android:textSize="@dimen/_11ssp"
        android:visibility="gone"
        tools:text="PvPHouse - Hoş geldin!"
        tools:visibility="visible" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/pvphouse_join_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/pvphouse_join_button"
        android:textAllCaps="true"
        android:textColor="@color/primary_text" />
</LinearLayout>
