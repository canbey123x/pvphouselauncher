<?xml version="1.0" encoding="utf-8"?>
<!-- PvPHouse home screen: logo, live status, one big PLAY button, three shortcuts.
     Tools and the upstream profile picker live in the ⋯ menu. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pvp_main_background">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/pvphouse_advanced_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_12sdp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/_150sdp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/pvphouse_server_title"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo" />

            <include
                layout="@layout/view_pvphouse_home_controls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

    <!-- Kept for MainMenuFragment, reachable from the ⋯ menu instead of buttons on screen -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints">
        <Button android:id="@+id/news_button" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/discord_button" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/install_jar_button" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/share_logs_button" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/open_files_button" android:layout_width="0dp" android:layout_height="0dp" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/pvphouse_more_button"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_margin="@dimen/_4sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/pvphouse_more"
        android:padding="@dimen/_8sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pvp_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Advanced mode (⋯ > Advanced mode): upstream profile picker + Play for other versions -->
    <LinearLayout
        android:id="@+id/pvphouse_advanced_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_bottom_bar"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:orientation="horizontal">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndPadding="@dimen/_1sdp"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_30sdp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_edit_profile" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/play_button"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="match_parent"
                android:text="@string/main_play"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
